# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real credentials.
# ---------------------------------------------------------------------------

# --- Required: Azure app registration (see README "Azure 应用注册") ---

# Application (client) ID
OUTLOOK_CLIENT_ID=

# Directory (tenant) ID
#
#   * Work / school account (single tenant)  -> your Directory (tenant) ID
#   * Multi-tenant app                       -> organizations
#   * Personal + work accounts both          -> common
OUTLOOK_TENANT_ID=

# --- Optional ---

# IANA timezone used for calendar start/end fields and for interpreting
# Graph's returned times. Defaults to UTC if unset, which makes day
# boundaries drift from your local midnight — set it.
# Examples: Asia/Shanghai, America/New_York, Europe/Berlin, Asia/Tokyo
# OUTLOOK_TIMEZONE=Asia/Shanghai

# Where the MSAL device-code token cache is written (mode 0600).
# Defaults to ~/.outlook-mcp/msal-cache.json
# OUTLOOK_TOKEN_CACHE=

# Send capability. OFF by default: every reply is saved to Drafts and you
# send it yourself from Outlook. Set to 1 only if you genuinely want the
# server to be able to send mail.
# OUTLOOK_ENABLE_SEND=1
